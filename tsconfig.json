{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmitOnError": true,
    "outDir": ".homeybuild",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "homematic-xmlrpc": ["src/types/homematic-xmlrpc"]
    },
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node", "vitest/globals"]
  },
  "include": ["app.js", "api.js", "src/**/*.ts", "lib/**/*", "drivers/**/*.js"],
  "exclude": [".homeybuild", "cli", "node_modules", "node-red", "tools"]
}
