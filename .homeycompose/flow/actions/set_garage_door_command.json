      "type": "dropdown",
      "title": { "en": "Command", "de": "Befehl" },
      "values": [
        { "id": "up", "label": { "en": "Open", "de": "Öffnen" } },
        { "id": "idle", "label": { "en": "Stop", "de": "Stopp" } },
        { "id": "down", "label": { "en": "Close", "de": "Schließen" } }
      ]
    }
  ]
