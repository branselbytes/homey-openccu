{
  "id": "io.github.branselbytes.openccu",
  "version": "0.1.6",
  "compatibility": ">=12.9.0",
  "sdk": 3,
  "name": {
    "en": "OpenCCU Local",
    "de": "OpenCCU Local"
  },
  "description": {
    "en": "Connect Homematic IP devices locally through OpenCCU",
    "de": "Homematic-IP-Geräte lokal über OpenCCU verbinden"
  },
  "tags": {
    "en": ["OpenCCU", "Homematic IP", "HmIP", "local"],
    "de": ["OpenCCU", "Homematic IP", "HmIP", "lokal"]
  },
  "category": ["tools", "appliances"],
  "permissions": [],
  "api": {
    "getDiscovery": {
      "method": "get",
      "path": "/discovery"
    },
    "getDiagnostics": {
      "method": "get",
      "path": "/diagnostics"
    },
    "getMemoryDiagnostics": {
      "method": "get",
      "path": "/diagnostics/memory"
    },
    "getHeatingTargets": {
      "method": "get",
      "path": "/heating/targets"
    },
    "readHeatingSchedule": {
      "method": "post",
      "path": "/heating/read"
    },
    "saveHeatingSchedule": {
      "method": "post",
      "path": "/heating/save"
    }
  },
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "brandColor": "#192c6e",
  "author": {
    "name": "branselbytes"
  },
  "bugs": {
    "url": "https://github.com/branselbytes/homey-openccu/issues"
  },
  "source": "https://github.com/branselbytes/homey-openccu",
  "homepage": "https://github.com/branselbytes/homey-openccu",
  "support": "https://github.com/branselbytes/homey-openccu/issues",
  "contributors": {
    "developers": [
      {
        "name": "Timo Wendt"
      },
      {
        "name": "Bjoern Welker"
      }
    ]
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "branselbytes"
      }
    }
  }
}
