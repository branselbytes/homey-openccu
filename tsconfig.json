{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmitOnError": true,
    "outDir": ".homeybuild",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "homematic-xmlrpc": ["src/types/homematic-xmlrpc"]
    },
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "target": "ES2023",
    "types": ["node"]
  },
  "include": [
    "api.ts",
    "app.ts",
    "src/**/*.ts",
    "widgets/**/*.ts",
    "drivers/**/*.ts"
  ],
  "exclude": [".homeybuild", "node_modules"]
}
