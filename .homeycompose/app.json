{
  "id": "io.github.branselbytes.openccu",
  "version": "0.1.0",
  "compatibility": ">=12.9.0",
  "sdk": 3,
  "name": {
    "en": "OpenCCU for Homey"
  },
  "description": {
    "en": "Connect Homematic and Homematic IP devices locally through OpenCCU"
  },
  "category": [
    "tools",
    "appliances"
  ],
  "permissions": [
    "homey:app:nl.scanno.mqtt"
  ],
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png"
  },
  "brandColor": "#192c6e",
  "author": {
    "name": "branselbytes"
  },
  "contributors": {
    "developers": [
      {
        "name": "Timo Wendt"
      },
      {
        "name": "Bjoern Welker"
      }
    ]
  },
  "api": {
    "getLogLines": {
      "method": "GET",
      "path": "/log/getloglines/",
      "public": false
    },
    "getStoredBridges": {
      "method": "GET",
      "path": "/bridges/get/",
      "public": false
    },
    "deleteStoredBridges": {
      "method": "GET",
      "path": "/bridges/delete/",
      "public": false
    }
  }
}
