{
  "title": { "en": "Control garage door", "de": "Garagentor steuern" },
  "titleFormatted": {
    "en": "Garage door: [[command]]",
    "de": "Garagentor: [[command]]"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
